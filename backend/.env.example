DJANGO_SECRET_KEY=change-this-in-production
APP_ENV=development
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 用于审计事件IP的HMAC，不应与客户端共享；生产建议独立随机配置。
AUDIT_IP_HASH_KEY=change-this-audit-hmac-key
DEBUG=true
ALLOW_USER_REGISTRATION=true

# 第十五阶段结构化日志、Trace、健康检查与任务收敛。
LOG_LEVEL=INFO
OTEL_ENABLED=false
OTEL_SERVICE_NAME=zhishu-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORT_TIMEOUT_SECONDS=3
CACHE_REDIS_URL=
POSTGRES_CONNECT_TIMEOUT=3
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_HEARTBEAT_TTL_SECONDS=90
STALE_TASK_SCAN_INTERVAL_SECONDS=60
STALE_TASK_THRESHOLD_SECONDS=420
METRICS_PORT=9101

# 企业成员邀请、密码重置与登录保护。本地默认只把邮件写到控制台。
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=知枢 <no-reply@localhost>
FRONTEND_BASE_URL=http://127.0.0.1:5173
INVITATION_EXPIRE_HOURS=168
PASSWORD_RESET_EXPIRE_SECONDS=3600
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
SECURE_HSTS_SECONDS=31536000
MODEL_CONFIG_ENCRYPTION_KEY=
ALLOW_PRIVATE_MODEL_ENDPOINTS=false

# 留空时使用完全离线的本地检索与证据降级回答
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

# 第八阶段异步文档处理。Docker/生产使用 false；自动化测试可覆盖为 true。
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=false
DOCUMENT_TASK_LOCK_BACKEND=redis
DOCUMENT_TASK_LOCK_REDIS_URL=redis://127.0.0.1:6379/2
DOCUMENT_TASK_SOFT_TIME_LIMIT=300
DOCUMENT_TASK_TIME_LIMIT=360
DOCUMENT_TASK_LOCK_TIMEOUT=420

# 第十阶段公开应用。生产环境填写实际前端 HTTPS 地址。
PUBLIC_FRONTEND_URL=http://127.0.0.1:5173
APPLICATION_RATE_LIMIT_BACKEND=redis
APPLICATION_RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379/3
APPLICATION_VISITOR_TOKEN_MAX_AGE=86400

# 第九阶段本地Cross-Encoder。生产默认只允许已下载的可信本地路径。
RERANKER_MODEL_PATH=
# 使用远程模型ID时固定Commit SHA；使用本地目录时由评测报告记录目录名称和权重哈希。
RERANKER_MODEL_REVISION=
RERANKER_DEVICE=cpu
RERANKER_MAX_LENGTH=512
RERANKER_MAX_CHARS=4000
RERANKER_BATCH_SIZE=8
RERANKER_TIMEOUT_SECONDS=3
RERANKER_ALLOW_DOWNLOAD=false

# 可选PostgreSQL临时验收环境；默认仍使用SQLite。
DATABASE_ENGINE=sqlite
POSTGRES_DB=knowledge_chat
POSTGRES_USER=knowledge_chat
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
