APP_ENV=production
DEBUG=false
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
AUDIT_IP_HASH_KEY=replace-with-an-independent-random-secret
MODEL_CONFIG_ENCRYPTION_KEY=replace-with-a-fernet-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:18080
FRONTEND_BASE_URL=http://127.0.0.1:18080
PUBLIC_FRONTEND_URL=http://127.0.0.1:18080
ALLOW_USER_REGISTRATION=false
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

POSTGRES_DB=zhishu
POSTGRES_USER=zhishu
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_CONNECT_TIMEOUT=3

# 向量存储灰度：首次上线保持LEGACY；回填期间改DUAL+SHADOW，验收后再PGVECTOR。
VECTOR_WRITE_MODE=LEGACY
VECTOR_READ_MODE=LEGACY
VECTOR_SEARCH_MODE=EXACT
VECTOR_SHADOW_SAMPLE_RATE=0
VECTOR_HNSW_EF_SEARCH=100

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CACHE_REDIS_URL=redis://redis:6379/4
DOCUMENT_TASK_LOCK_BACKEND=redis
DOCUMENT_TASK_LOCK_REDIS_URL=redis://redis:6379/2
APPLICATION_RATE_LIMIT_BACKEND=redis
APPLICATION_RATE_LIMIT_REDIS_URL=redis://redis:6379/3
STALE_TASK_THRESHOLD_SECONDS=420

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORT_TIMEOUT_SECONDS=3
LOG_LEVEL=INFO

OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
RERANKER_MODEL_PATH=
RERANKER_MODEL_REVISION=
RERANKER_ALLOW_DOWNLOAD=false
